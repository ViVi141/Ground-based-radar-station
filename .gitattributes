# Force LF for localization runtime conf — Workbench/engine StringTableRuntime
# parser is line-ending sensitive; git core.autocrlf would otherwise rewrite
# these to CRLF on checkout.
Language/*.conf text eol=lf
*.st text eol=lf

# Scripts / layouts / configs keep native (repo) LF too.
*.c text eol=lf
*.et text eol=lf
*.layout text eol=lf
*.conf text eol=lf
*.meta text eol=lf
*.py text eol=lf
*.json text eol=lf
*.gproj text eol=lf
