# Force LF for localization runtime conf — Workbench/engine StringTableRuntime
# parser is line-ending sensitive; git core.autocrlf would otherwise rewrite
# these to CRLF on checkout. -text stores the blob byte-for-byte (LF) with no
# clean/checkout conversion at all.
Language/*.conf -text
*.st -text

# Scripts / layouts / configs keep repo-native LF (no conversion either).
*.c -text
*.et -text
*.layout -text
*.conf -text
*.meta -text
*.py -text
*.json -text
*.gproj -text
